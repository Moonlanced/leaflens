# REQUIRED. Random 32+ byte secret that signs login sessions.
# Generate one:  openssl rand -hex 32
SESSION_SECRET=

# Allow new accounts to be created from the sign-in page.
# Leave "true" to invite friends; set "false" to lock it down afterward.
ALLOW_SIGNUP=true

# Set to "true" when you serve LeafLens over HTTPS (e.g. nginx).
# Must stay "false" for plain http://localhost or the login cookie won't be sent.
COOKIE_SECURE=false

# Max PDF size in MB (applies to uploads and URL-pulled files).
MAX_UPLOAD_MB=60

# For "Link to a URL" publications: how long (seconds) LeafLens caches the pulled
# PDF before re-fetching from the source. Use the dashboard "Re-sync" button to force it.
PDF_CACHE_TTL=600

# Footgun — leave "false". When "true", the URL-source fetcher is allowed to reach
# private/loopback addresses (10.x, 127.x, 192.168.x, etc). Only enable on a trusted
# single-tenant install where you pull PDFs from a LAN file server. It disables the
# SSRF guard, so never enable it on a server where other people can create accounts.
ALLOW_PRIVATE_FETCH=false
