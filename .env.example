# REQUIRED. Random 32+ byte secret that signs login sessions.
# Generate one:  openssl rand -hex 32
SESSION_SECRET=

# Allow new accounts to be created from the sign-in page.
# Leave "true" to invite friends; set "false" to lock it down afterward.
ALLOW_SIGNUP=true

# Set to "true" when you serve LeafLens over HTTPS (e.g. nginx).
# Must stay "false" for plain http://localhost or the login cookie won't be sent.
COOKIE_SECURE=false

# Max PDF upload size in MB.
MAX_UPLOAD_MB=60
